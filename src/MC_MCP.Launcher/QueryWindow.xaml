<Window x:Class="MC_MCP.Launcher.QueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查询" Height="620" Width="1080" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F3F4F6">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock x:Name="HintText" Margin="12,4,0,0" FontSize="12" Foreground="#6B7280" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="查询" Width="92" Height="30"
                    Margin="8,0,0,0" Click="OnSearchClick" IsDefault="True" />
            <Button x:Name="NextPageButton" DockPanel.Dock="Right" Content="下一页" Width="76" Height="30"
                    Margin="8,0,0,0" Click="OnNextPageClick"
                    ToolTip="按“当前 offset + 本次返回条数”翻页，与 MCP 工具 warning 提示一致" />
            <TextBlock x:Name="OffsetLabel" DockPanel.Dock="Right" Text="Offset" VerticalAlignment="Center"
                       Margin="8,0,0,0" Foreground="#555555" />
            <TextBox x:Name="OffsetBox" DockPanel.Dock="Right" Width="56" Height="30" Margin="8,0,0,0"
                     Text="0" VerticalContentAlignment="Center"
                     ToolTip="跳过前 offset 条；结果截断时按提示递增" />
            <TextBlock x:Name="TopKLabel" DockPanel.Dock="Right" Text="Top K" VerticalAlignment="Center"
                       Margin="8,0,0,0" Foreground="#555555" Visibility="Collapsed" />
            <TextBox x:Name="TopKBox" DockPanel.Dock="Right" Width="56" Height="30" Margin="8,0,0,0"
                     Text="10" VerticalContentAlignment="Center" Visibility="Collapsed"
                     ToolTip="返回条数 top_k（1-50）" />
            <TextBox x:Name="QueryBox" Height="30" VerticalContentAlignment="Center" Padding="6,0"
                     Background="White" BorderBrush="#D1D5DB" />
        </DockPanel>

        <DataGrid x:Name="ResultGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeaderWidth="0" Background="White"
                  BorderBrush="#E5E7EB" MouseDoubleClick="OnGridDoubleClick" />

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" FontSize="12" Foreground="#6B7280"
                   TextWrapping="Wrap" Text="双击结果行可在 cursor / code 中跳转到源码。" />
    </Grid>
</Window>
